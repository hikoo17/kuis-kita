# Salin file ini menjadi ".env" lalu isi dengan kredensial Supabase Anda.
# Ambil nilainya di: Supabase Dashboard -> tombol "Connect" (atau Settings -> API Keys)

# 1) Project URL — bentuknya: https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=your_supabase_url

# 2) Kunci publik untuk frontend. Isi SALAH SATU:
#    - "Publishable key"  (sb_publishable_...)  <- kunci baru, dianjurkan
#    - "anon public"      (eyJhbGciOi...)       <- kunci lama, masih jalan sampai akhir 2026
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# 3) PIN sederhana untuk halaman /admin (khusus demo/sekolah).
#    Untuk aplikasi produksi, gunakan Supabase Auth, bukan PIN di sisi klien.
VITE_ADMIN_PIN=1234

# JANGAN pernah menaruh Secret key / service_role di sini. Itu hanya untuk server.
